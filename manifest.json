{
  "manifest_version": 3,
  "name": "HC",
  "version": "1.9.3",
  "description": "Hide table columns by aria-label. Manage rules from the extension popup.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HC"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-logic.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["page-logic.js", "content.js", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
